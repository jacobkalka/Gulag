{
  "name": "lockdown",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "LOCKDOWN - a fast, small-arena multiplayer browser shooter.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "shots": "node scripts/screenshot.mjs",
    "balance": "tsx scripts/balance.ts --compare",
    "test:rules": "npx -y firebase-tools@15.33.0 --config firebase/emulators.test.json emulators:exec --only firestore,database --project demo-lockdown \"vitest run -c vitest.rules.config.ts\"",
    "emulators": "npx -y firebase-tools@15.33.0 emulators:start --only auth,firestore,database --project demo-lockdown"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/big-shoulders-stencil-display": "^5.3.0",
    "@fontsource/share-tech-mono": "^5.3.0",
    "@preact/signals": "^2.11.3",
    "firebase": "^13.0.0",
    "n8ao": "^2.0.1",
    "postprocessing": "6.39.5",
    "preact": "^10.29.8",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "1.56.1",
    "@types/node": "^22.20.5",
    "@types/three": "0.186.0",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "engines": {
    "node": ">=22.12"
  }
}
