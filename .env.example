# Copy to .env.local (gitignored) for local development. In CI these come from
# GitHub repository secrets (see SETUP.md). Leave empty to run offline.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_APP_ID=

# Optional TURN relay (see SETUP.md section 8). Either a credentials endpoint returning
# RTCIceServer[] JSON...
VITE_TURN_CREDENTIALS_URL=
# ...or static credentials
VITE_TURN_URLS=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=

# Use the local Firebase Emulator Suite (same as ?emulators=1)
VITE_FIREBASE_EMULATORS=
